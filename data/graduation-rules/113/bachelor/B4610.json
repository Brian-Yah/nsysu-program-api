  "manual_review_rules": [
    {
      "rule_id": "ibba_overseas_exchange",
      "description": "本籍生畢業前須至海外交換至少一學年，修習非中文授課且學士級以上課程；返校後申請抵免至少18至24學分或6門課。",
      "reason": "交換期間、授課語言、課程層級及返校抵免結果皆需官方紀錄，不能只由已修課名稱自動判斷。",
      "source_document": "ibba-113",
      "resolution": "查核交換紀錄、國外成績單及教務處核定之交換抵免表。"
    },
    {
      "rule_id": "ibba_international_or_interdisciplinary_learning",
      "description": "109學年度起入學學生須符合至少一項國際或跨域學習畢業條件。",
      "reason": "交換、研修時數、學程證書與系所審查同意均需校方紀錄。",
      "source_document": "ibba-113",
      "resolution": "畢業審查時查核交換、研修、輔系、雙主修或學程完成證明。"
    },
    {
      "rule_id": "ibba_featured_elective_module_counting",
      "description": "官方課程地圖列出三個特色選修模組及參考課程，但必修科目表未設定每模組最低門數或學分。",
      "reason": "不得從課程地圖版面推導不存在的跨模組門檻。",
      "source_document": "ibba-113",
      "resolution": "僅作課程規劃提示；若系所另有模組完成門檻，須取得正式修業規定後新增。"
    }
  ],
