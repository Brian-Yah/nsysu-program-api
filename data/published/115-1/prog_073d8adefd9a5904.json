{
  "program_id": "prog_073d8adefd9a5904",
  "name_zh": "地方創生與永續發展學程",
  "name_en": null,
  "previous_names": [],
  "type": "integrated_program",
  "status": "active",
  "description": "融合「永續發展」、「地方創生」相關概念,規劃跨院所科系之課程,內容包含永續管理、地區及區域發展等議題,透過課程講授、實作及實務界見學等,從不同面向提供理論與實務兼具之課程,供學生多元選擇。期望培養能從永續管理角度,了解公私部門資源、妥善連結各利害關係人及單位,推進地方事務之人才。",
  "responsible_unit": "公事所",
