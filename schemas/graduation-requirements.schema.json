{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brian-yah.github.io/nsysu-program-api/api/v1/schemas/graduation-requirements.schema.json",
  "title": "NSYSU Graduation Requirements Collection",
  "type": "object",
  "required": [
    "schema_version",
    "entry_academic_year",
    "degree_level",
    "retrieved_at",
    "department_count",
    "requirements",
    "unavailable_departments",
    "source"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "entry_academic_year": {"type": "string", "pattern": "^[0-9]{3}$"},
    "degree_level": {"const": "bachelor"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "department_count": {"type": "integer", "minimum": 1},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "graduation-requirement.schema.json"}
    },
    "unavailable_departments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["department_code", "department_name", "reason"],
        "properties": {
          "department_code": {"type": "string"},
          "department_name": {"type": "string"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "source": {
      "type": "object",
      "required": ["index_url", "index_binary_sha256", "parser_version"],
      "properties": {
        "index_url": {"type": "string", "format": "uri"},
        "index_binary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "parser_version": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
