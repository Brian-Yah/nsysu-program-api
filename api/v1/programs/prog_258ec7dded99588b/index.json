  "program": {
    "program_id": "prog_258ec7dded99588b",
    "name_zh": "沉浸式體驗技術與應用學程  (★自113年2月1日起停止受理申請修讀學程)",
    "name_en": null,
    "previous_names": [],
    "type": "integrated_program",
    "status": "discontinued",
    "description": "「沉浸式體驗」所需具備的技術層面涵蓋光學投影、色彩呈現、影像處理、機電控制與體感回饋,而在內容的呈現與應用場域上則涵蓋極廣,包含音樂、劇場、文化、教育、醫療等。本整合學程融合與沉浸式體驗技術及應用面相關之各系所專業,以實例教學與專案式訓練,協助來自不同領域的學生將心中的奇想淬煉成妙想,實現成可展演、有技術內涵、有應用能力的實體作品,增加學生的跨界思考與合作/實作能力。",
    "responsible_unit": "電機系",
    "coordinator": "邱日清副教授",
